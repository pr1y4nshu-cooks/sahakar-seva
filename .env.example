APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://sahakar:sahakar@localhost:55432/sahakar_seva
POSTGRES_DB=sahakar_seva
POSTGRES_USER=sahakar
POSTGRES_PASSWORD=sahakar
FRONTEND_API_BASE_URL=http://localhost:8000
# Comma-separated list of exact origins. Wildcard "*" is rejected (credentials are allowed).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Backend Supabase token verification (server-only; never copy into VITE_* variables) ---
# The API verifies bearer tokens using ONE of these modes and fails closed (HTTP 503) if neither is configured:
#   Mode A: SUPABASE_JWT_SECRET set -> local HS256 signature + aud("authenticated") + exp verification.
#           Only valid for projects using the legacy shared JWT secret. Asymmetric (RS256/ES256) projects
#           must leave this blank and use Mode B.
#   Mode B: SUPABASE_URL + SUPABASE_ANON_KEY set -> server-side validation via GET {SUPABASE_URL}/auth/v1/user.
# If SUPABASE_JWT_SECRET is set, Mode A takes precedence.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# --- Simulated settlement fee policy (pilot assumption, basis points: 1000 = 10%) ---
# The API refuses to start if PLATFORM_FEE_BPS > PLATFORM_FEE_CAP_BPS or the cap exceeds 2000.
PLATFORM_FEE_BPS=1000
PLATFORM_FEE_CAP_BPS=1500

# --- Local demo identity (NOT production authentication) ---
# Only for local demos without Supabase credentials. Requires APP_ENV=development; the API refuses to
# start otherwise. Tokens are signed with DEV_AUTH_SECRET (>= 32 chars, never a Supabase secret) and are
# rejected whenever DEV_AUTH_ENABLED is false. Only @demo.sahakar.test emails are accepted.
# Generate a secret with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DEV_AUTH_ENABLED=false
DEV_AUTH_SECRET=
DEV_AUTH_PASSCODE=
# Frontend identity mode passed to the web container: "supabase" (default) or "dev".
VITE_AUTH_MODE=supabase
# Public Supabase values for the web container (anon/publishable key only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

