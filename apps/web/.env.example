# Copy to apps/web/.env.local (git-ignored). Every VITE_* value is embedded in the public browser bundle.
# Only public values belong here: NEVER put a Supabase service-role key, secret key, or JWT secret in this file.

# FastAPI base URL (defaults to http://localhost:8000 when unset)
VITE_API_BASE_URL=http://localhost:8000

# Supabase project URL and public anon/publishable key (Project Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
